---
import { Analytics } from '@vercel/analytics/react';

interface Props {
  title?: string;
}

const { title = "Abolfazl Eslahi — Full-Stack Developer" } = Astro.props;

// پیکربندی آدرس پایه و هویت برند شخصی
const siteUrl = "https://yeplahy.ir";
const authorName = "Abolfazl Eslahi";
const roleTitle = "Full-Stack Developer";
const siteDescription =
  "Abolfazl Eslahi (yeplahy) — Full-Stack Developer specializing in scalable web architecture, high-performance frontend interfaces, and type-safe systems.";
const ogImageUrl = `${siteUrl}/og.image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={siteDescription} />
    <meta name="author" content={authorName} />

    <!-- Canonical URL -->
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Preload Fonts (Performance-First) -->
    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={`${authorName} — ${roleTitle}`} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={`${authorName} Portfolio`} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={`${authorName} — ${roleTitle}`} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data (Schema.org JSON-LD for Rich Results) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Abolfazl Eslahi",
        "alternateName": "yeplahy",
        "url": "https://yeplahy.ir",
        "image": "https://yeplahy.ir/og.image.png",
        "sameAs": [
          "https://github.com/yeplahy",
          "https://linkedin.com/in/yeplahy"
        ],
        "jobTitle": "Full-Stack Developer",
        "worksFor": {
          "@type": "Organization",
          "name": "Freelance & Open Source"
        },
        "description": "Full-Stack Developer building scalable web applications, robust cloud APIs, and high-performance user interfaces."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
    <Analytics client:load />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    /* Persian Blue Accent Spectrum (WCAG 2.2 AA Compliant on #101010) */
    --sec: #387aff;
    --sec-hover: #5d93ff;
    --sec-glow: rgba(56, 122, 255, 0.35);
    
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
    --container: #161616;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: #ffffff;
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 12px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 20px;
  }

  ::-webkit-scrollbar-thumb {
    background: #232323;
    border-radius: 10px;
    border: 2px solid var(--container);
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: #2a2a2a var(--container);
  }
</style>

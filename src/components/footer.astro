---
const currentYear = new Date().getFullYear();
---

<footer class="max-w-5xl mx-auto py-10 px-4 mt-16 border-t border-[var(--white-icon-tr)] text-sm text-[var(--white-icon)]">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
    <p>
      &copy; {currentYear} <span class="text-[var(--white)] font-medium">Abolfazl Eslahi</span>. All rights reserved.
    </p>

    <p class="text-xs text-[var(--white-icon)]/70">
      Engineered with <span class="text-[var(--white)]">Astro</span> & <span class="text-[var(--white)]">Tailwind CSS</span>
    </p>
  </div>
</footer>

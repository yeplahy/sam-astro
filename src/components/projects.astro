---
interface Project {
  title: string;
  image: string;
  link: string;
  preview: string;
  tags: string[];
}

const projects: Project[] = [
  {
    title: "Persian Bio",
    image: "/projects/pbioco.png",
    link: "https://github.com/SAMamiralimosavi",
    preview: "https://pbioco.ir",
    tags: ["Co-Founder & CEO", "Product Strategy", "Biotech Platform"],
  },
  {
    title: "Taxino",
    image: "/projects/taxino.png",
    link: "https://github.com/SAMamiralimosavi",
    preview: "https://taxiin-service.ir/",
    tags: ["Founder & CEO", "Agile / Scrum", "Ride-Hailing"],
  },
];
---

<section class="max-w-5xl mx-auto py-16" id="projects">
  <div class="space-y-2 mb-10">
    <p class="text-xs font-mono font-medium text-[var(--sec)] tracking-widest uppercase">
      Selected Works
    </p>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--white)]">
      Featured Projects
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      projects.map((project) => (
        <article class="group relative flex flex-col justify-between p-5 rounded-2xl bg-[#121214] border border-[var(--white-icon-tr)] hover:border-[var(--sec)]/70 transition-all duration-300 hover:shadow-[0_0_24px_rgba(255,255,255,0.03)]">
          <div class="space-y-4">
            {/* Visual Thumbnail */}
            <a
              href={project.preview}
              target="_blank"
              rel="noopener noreferrer"
              class="block relative aspect-[16/9] w-full overflow-hidden rounded-xl bg-zinc-900 border border-white/5"
              aria-label={`Open preview for ${project.title}`}
            >
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-[1.03] transition-all duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
            </a>

            {/* Header: Title + Live Status Indicator */}
            <div class="space-y-2 pt-1">
              <div class="flex items-center justify-between gap-3">
                <a
                  href={project.preview}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-lg font-semibold text-[var(--white)] hover:text-[var(--sec)] transition-colors flex items-center gap-2"
                >
                  <span>{project.title}</span>
                  <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400/80 shadow-[0_0_8px_rgba(52,211,153,0.6)]" title="Online" />
                </a>
              </div>
              {/* Minimal Technology & Strategy Tags */}
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="text-[11px] font-mono text-zinc-300 bg-white/[0.06] px-2 py-0.5 rounded border border-white/[0.08]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          {/* Clean Action Links */}
          <div class="pt-5 mt-4 flex items-center justify-between text-xs border-t border-white/5">
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[var(--white-icon)] hover:text-[var(--white)] transition-colors"
              aria-label={`Source repository for ${project.title}`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              <span>Code</span>
            </a>

            <a
              href={project.preview}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-[var(--sec)] hover:text-white transition-colors group/link font-medium"
            >
              <span>Visit project</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

---
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="text-left space-y-4">
      <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
        Hi, I'm AmirAli Mosavi
      </p>
      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <h1
          class="text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none"
        >
          CEO & Product <br /> Designer
        </h1>
        <p class="text-md md:text-2xl text-[var(--white-icon)]">
          Leading ventures and crafting user-centric products with <span class="shiny-sec font-semibold">analytical rigor</span> and beginner front-end engineering.
        </p>
      </div>

      <!-- Social & Academic Profiles (Updated to Dark Teal & Maroon Palette) -->
      <div class="flex flex-wrap justify-start gap-3 pt-3 md:pt-6">
        <!-- LinkedIn -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.linkedin.com/feed/"
          aria-label="LinkedIn Profile"
          class="text-[var(--white-icon)] hover:text-[#29979f] hover:border-[#29979f]/60 hover:shadow-[0_0_18px_rgba(41,151,159,0.25)] transition-all duration-300 ease-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#2125299c] hover:bg-[#2b2d42]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-7"
            aria-hidden="true"
          >
            <path
              d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.67 1.67 0 1 0 0-3.34a1.67 1.67 0 0 0 0 3.34m1.4 9.74V9.93H5.06v8.57h2.8Z"
            ></path>
          </svg>
        </a>

        <!-- Telegram -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://t.me/SAMamiralimosavi"
          aria-label="Telegram Direct"
          class="text-[var(--white-icon)] hover:text-[#29979f] hover:border-[#29979f]/60 hover:shadow-[0_0_18px_rgba(41,151,159,0.25)] transition-all duration-300 ease-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#2125299c] hover:bg-[#2b2d42]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-7"
            aria-hidden="true"
          >
            <path
              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"
            ></path>
          </svg>
        </a>

        <!-- Google Scholar -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://scholar.google.com/citations?hl=en&user=p6GVjicAAAAJ&view_op=list_works&citft=1&email_for_op=s.amiralimosavisam@gmail.com&gmla=GAPGPTMASKTOKEN9zb6kysq78X0X"
          aria-label="Google Scholar Profile"
          class="text-[var(--white-icon)] hover:text-[#29979f] hover:border-[#29979f]/60 hover:shadow-[0_0_18px_rgba(41,151,159,0.25)] transition-all duration-300 ease-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#2125299c] hover:bg-[#2b2d42]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-7"
            aria-hidden="true"
          >
            <path
              d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"
            ></path>
          </svg>
        </a>

        <!-- ORCID -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://orcid.org/0009-0000-2610-9379"
          aria-label="ORCID Profile"
          class="text-[var(--white-icon)] hover:text-[#29979f] hover:border-[#29979f]/60 hover:shadow-[0_0_18px_rgba(41,151,159,0.25)] transition-all duration-300 ease-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#2125299c] hover:bg-[#2b2d42]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-7"
            aria-hidden="true"
          >
            <path
              d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.541 0 .979.439.979.979s-.438.979-.979.979-.979-.439-.979-.979.438-.979.979-.979zm-.815 3.018h1.63v9.845h-1.63V7.396zm5.06 0h3.585c2.953 0 4.772 1.947 4.772 4.922 0 2.977-1.82 4.923-4.772 4.923h-3.585V7.396zm1.63 1.503v6.839h1.834c1.922 0 3.235-1.125 3.235-3.419 0-2.296-1.313-3.42-3.235-3.42h-1.834z"
            ></path>
          </svg>
        </a>

        <!-- Email -->
        <a
          href="mailto:s.amiralimosavisam@gmail.com"
          aria-label="Direct Email"
          class="text-[var(--white-icon)] hover:text-[#29979f] hover:border-[#29979f]/60 hover:shadow-[0_0_18px_rgba(41,151,159,0.25)] transition-all duration-300 ease-out border border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#2125299c] hover:bg-[#2b2d42]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-7"
            aria-hidden="true"
          >
            <path
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Tech Stack Logos -->
    <LogoWall />

    <!-- Interactive Systems & Skills Terminal -->
    <div class="w-full pt-6">
      <SkillsList client:load />
    </div>
  </div>
</section>

<style is:global>
  /* Executive palette: teal accent with a restrained maroon transition */
  .shiny-sec {
    background: linear-gradient(
      135deg,
      #29979f 0%,
      #29979f 45%,
      #7e5368 75%,
      #8f4057 100%
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine-palette 3.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    display: inline-block;
  }

  @keyframes shine-palette {
    0% {
      background-position: 100% 50%;
    }
    40%,
    60% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }
</style>

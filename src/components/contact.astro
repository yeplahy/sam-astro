---
const email = "yeplahy@gmail.com";
---

<section class="max-w-5xl mx-auto py-16" id="contact">
  <div class="space-y-2 mb-10">
    <p class="text-sm font-semibold text-[var(--sec)] tracking-wider uppercase">
      Get In Touch
    </p>
    <h2 class="text-3xl md:text-4xl font-bold text-[var(--white)]">
      Let's Connect
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
    <!-- Info Column -->
    <div class="bg-[#14141460] border border-[var(--white-icon-tr)] rounded-2xl p-8 flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <h3 class="text-2xl font-semibold text-[var(--white)]">
          Have an idea or a project in mind?
        </h3>
        <p class="text-[var(--white-icon)] leading-relaxed">
          I'm always open to discussing new opportunities, Bio-IT challenges, architecture consulting, or creative collaborations.
        </p>
      </div>

      <div class="space-y-3 pt-4 border-t border-[var(--white-icon-tr)]/50">
        <div class="flex items-center gap-3 text-sm text-[var(--white-icon)]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-[var(--sec)] shrink-0"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>Location: <strong class="text-[var(--white)]">Hamedan, Iran</strong></span>
        </div>

        <div class="flex items-center gap-3 text-sm text-[var(--white-icon)]">
          <span class="relative flex h-2.5 w-2.5 shrink-0 ml-1 mr-0.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="text-emerald-400 font-medium">Available for remote projects</span>
        </div>
      </div>
    </div>

    <!-- Direct Action Card -->
    <div class="bg-[#14141460] border border-[var(--white-icon-tr)] rounded-2xl p-8 flex flex-col justify-between items-start space-y-6 hover:border-[var(--sec)] transition-colors duration-300">
      <div class="space-y-3">
        <p class="text-xs font-mono uppercase tracking-wider text-[var(--sec)]">
          Direct Communication
        </p>
        <h3 class="text-2xl font-bold text-[var(--white)]">
          Start a Conversation
        </h3>
        <p class="text-[var(--white-icon)] text-sm leading-relaxed">
          Drop me an email directly. I usually respond within 24 hours.
        </p>
      </div>

      <a
        href={`mailto:${email}?subject=Project%20Inquiry%20via%20Portfolio`}
        class="w-full inline-flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-[var(--white)] text-[var(--black)] font-semibold hover:bg-[var(--sec)] hover:text-white transition-all duration-300 group shadow-lg"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="group-hover:translate-x-0.5 transition-transform"
          aria-hidden="true"
        >
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <span>Send an Email</span>
      </a>
    </div>
  </div>
</section>
